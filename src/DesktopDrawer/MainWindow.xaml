<Window x:Class="DesktopDrawer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Drawer"
        Icon="Assets/app.ico"
        Width="1440"
        Height="852"
        MinWidth="720"
        MinHeight="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{DynamicResource FontSize13}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Closing="Window_Closing"
        Closed="Window_Closed"
        SizeChanged="Window_SizeChanged"
        Activated="Window_Activated"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput">

    <Window.Resources>
        <Style x:Key="DesktopListItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Card"
                                Margin="4"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource TileHoverBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource TileHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="10" />
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RenameTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource RenameSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionOpacity" Value="0.35" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="4,3">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DesktopItemTemplate">
            <Grid ToolTipService.InitialShowDelay="550"
                  ToolTipService.ShowDuration="20000"
                  AutomationProperties.Name="{Binding DisplayName}">
                <Grid.ToolTip>
                    <ToolTip>
                        <StackPanel MaxWidth="360">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="{DynamicResource FontSize125}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TypeLabel}"
                                       FontSize="{DynamicResource FontSize11}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding FullPath}"
                                       FontSize="{DynamicResource FontSize105}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0" />
                            <TextBlock Text="{Binding ModifiedText}"
                                       FontSize="{DynamicResource FontSize105}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </ToolTip>
                </Grid.ToolTip>

                <Grid x:Name="Tile"
                      Margin="2"
                      Background="Transparent"
                      VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Image Source="{Binding Icon}"
                               Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="FileGlyph"
                                   Style="{StaticResource Glyph}"
                                   Text="&#xE7C3;"
                                   FontSize="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                   Foreground="{DynamicResource IconPlaceholderBrush}"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="FolderGlyph"
                                   Style="{StaticResource Glyph}"
                                   Text="&#xE8B7;"
                                   FontSize="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                   Foreground="{DynamicResource IconPlaceholderBrush}"
                                   Visibility="Collapsed" />
                    </Grid>

                    <Canvas Grid.Row="1"
                            Margin="0,7,0,0"
                            Height="{Binding DataContext.TileNameHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            ClipToBounds="False">
                        <TextBlock x:Name="NameText"
                                   Canvas.Left="0"
                                   Canvas.Top="0"
                                   Width="{Binding ActualWidth, ElementName=Tile}"
                                   Text="{Binding DisplayName}"
                                   FontSize="{Binding DataContext.TileFontSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                   MaxHeight="{Binding DataContext.TileNameHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   TextAlignment="Center"
                                   LineHeight="16"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Canvas>

                    <TextBox x:Name="RenameBox"
                             Grid.Row="1"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="{Binding DataContext.TileFontSize, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Style="{StaticResource RenameTextBox}"
                             MaxHeight="44"
                             Margin="0,6,0,0"
                             Visibility="Collapsed"
                             IsVisibleChanged="RenameBox_IsVisibleChanged"
                             KeyDown="RenameBox_KeyDown"
                             LostFocus="RenameBox_LostFocus" />
                </Grid>
            </Grid>

                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                        <Setter TargetName="NameText" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                 Value="True">
                        <Setter TargetName="NameText" Property="MaxHeight" Value="480" />
                        <Setter TargetName="NameText" Property="TextTrimming" Value="None" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                        <Setter TargetName="FileGlyph" Property="Visibility" Value="Visible" />
                    </DataTrigger>

                    <!-- The placeholder folder glyph is only for folders without a
                         real icon; drawing it over the icon leaves a white outline. -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsFolder}" Value="True" />
                            <Condition Binding="{Binding HasIcon}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="FolderGlyph" Property="Visibility" Value="Visible" />
                        <Setter TargetName="FileGlyph" Property="Visibility" Value="Collapsed" />
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                        <Setter TargetName="Tile" Property="Opacity" Value="0.6" />
                    </DataTrigger>
                </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#01FFFFFF">
        <Rectangle x:Name="WallpaperDimLayer"
                   Fill="#000000"
                   Opacity="0"
                   IsHitTestVisible="False" />
        <Grid>
            <Border x:Name="HeaderBar"
                    Height="58"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="9"
                                Background="{DynamicResource BadgeSurfaceBrush}"
                                BorderBrush="{DynamicResource BadgeBorderBrush}"
                                BorderThickness="1">
                            <Image Source="Assets/app.png"
                                   Width="32"
                                   Height="32"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str.App.Title}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="{DynamicResource FontSize14}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Str.App.Subtitle}"
                                       FontSize="{DynamicResource FontSize10}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Grid x:Name="SearchField"
                          Grid.Column="1"
                          MinWidth="150"
                          MaxWidth="320"
                          Height="32"
                          Margin="10,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          IsKeyboardFocusWithinChanged="SearchField_IsKeyboardFocusWithinChanged"
                          MouseEnter="SearchField_MouseEnter"
                          MouseLeave="SearchField_MouseLeave"
                          PreviewMouseLeftButtonDown="SearchField_PreviewMouseLeftButtonDown">
                        <Border Style="{StaticResource SearchBoxBorder}" />
                        <Border x:Name="SearchHoverLayer"
                                Background="{DynamicResource PanelHoverBrush}"
                                BorderBrush="{DynamicResource TileHoverBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="SearchFocusLayer"
                                Background="{DynamicResource SearchFocusSurfaceBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Opacity="0"
                                IsHitTestVisible="False" />

                        <Grid Margin="11,0,7,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Width="14"
                                  Height="14"
                                  Margin="0,0,9,0"
                                  VerticalAlignment="Center">
                                <Path Stroke="{DynamicResource TextMutedBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 6.2,1.2 A 5,5 0 1 1 6.2,11.2 A 5,5 0 1 1 6.2,1.2 M 10.2,10.2 L 13.2,13.2" />
                                <Path x:Name="SearchIconAccent"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 6.2,1.2 A 5,5 0 1 1 6.2,11.2 A 5,5 0 1 1 6.2,1.2 M 10.2,10.2 L 13.2,13.2"
                                      Opacity="0" />
                            </Grid>

                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox"
                                         Style="{StaticResource SearchTextBox}"
                                         FontSize="{DynamicResource FontSize125}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                                         GotKeyboardFocus="SearchBox_GotKeyboardFocus" />
                                <TextBlock Text="{DynamicResource Str.Search.Placeholder}"
                                           FontSize="{DynamicResource FontSize125}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Panel.ZIndex="-1">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasSearchText}" Value="False" />
                                                        <Condition Binding="{Binding IsSearchFocused}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 To="1"
                                                                                 Duration="0:0:0.18" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 To="0"
                                                                                 Duration="0:0:0.1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button Grid.Column="2"
                                    x:Name="ClearSearchButton"
                                    Width="22"
                                    Height="22"
                                    Style="{StaticResource SearchClearButton}"
                                    Click="ClearSearchButton_Click"
                                    ToolTip="{DynamicResource Str.Search.Clear}"
                                    Focusable="False"
                                    Opacity="0"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibility}}"
                                    IsVisibleChanged="ClearSearchButton_IsVisibleChanged">
                                <Button.RenderTransform>
                                    <ScaleTransform x:Name="ClearSearchScale"
                                                    ScaleX="0.7"
                                                    ScaleY="0.7"
                                                    CenterX="11"
                                                    CenterY="11" />
                                </Button.RenderTransform>
                                <TextBlock Style="{StaticResource Glyph}"
                                           Text="&#xE711;"
                                           FontSize="{DynamicResource FontSize95}" />
                            </Button>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="SortButton"
                                Style="{StaticResource ToolbarButton}"
                                Height="32"
                                Padding="8,0"
                                Click="SortButton_Click"
                                ToolTip="{DynamicResource Str.Header.Sort}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}"
                                           Text="&#xE8CB;"
                                           FontSize="{DynamicResource FontSize12}"
                                           Margin="0,0,5,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="SortLabelText"
                                           Text="{DynamicResource Str.Sort.Name}"
                                           FontSize="{DynamicResource FontSize115}"
                                           VerticalAlignment="Center" />
                                <Path Width="7"
                                      Height="4"
                                      Margin="5,1,0,0"
                                      Stretch="Fill"
                                      Fill="{DynamicResource TextMutedBrush}"
                                      Data="M 0,0 L 8,0 L 4,5 Z"
                                      VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource IconButton}"
                                Width="32"
                                Height="32"
                                Margin="2,0,0,0"
                                Click="RefreshButton_Click"
                                ToolTip="{DynamicResource Str.Header.Refresh}">
                            <TextBlock Style="{StaticResource Glyph}"
                                       Text="&#xE72C;"
                                       FontSize="{DynamicResource FontSize14}" />
                        </Button>

                        <ToggleButton x:Name="HideIconsToggle"
                                      Style="{StaticResource IconToggleButton}"
                                      Width="32"
                                      Height="32"
                                      Margin="2,0,0,0"
                                      Click="HideIconsToggle_Click"
                                      ToolTip="{DynamicResource Str.Header.HideIcons}">
                            <Grid Width="17" Height="17">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 1,9 C 3.6,4.7 6.4,3 9,3 C 11.6,3 14.4,4.7 17,9 C 14.4,13.3 11.6,15 9,15 C 6.4,15 3.6,13.3 1,9 Z" />
                                <Ellipse Width="4.2"
                                         Height="4.2"
                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                                <Path x:Name="EyeSlash"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 3,15.5 L 15,2.5">
                                    <Path.Style>
                                        <Style TargetType="{x:Type Path}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </ToggleButton>

                        <Button Style="{StaticResource IconButton}"
                                Width="32"
                                Height="32"
                                Margin="2,0,0,0"
                                Click="SettingsButton_Click"
                                ToolTip="{DynamicResource Str.Header.Settings}">
                            <TextBlock Style="{StaticResource Glyph}"
                                       Text="&#xE713;"
                                       FontSize="{DynamicResource FontSize15}" />
                        </Button>

                        <Border Width="1"
                                Height="16"
                                Background="{DynamicResource DividerStrongBrush}"
                                Margin="5,0" />

                        <Button Style="{StaticResource IconButton}"
                                Width="32"
                                Height="32"
                                Click="MinimizeButton_Click"
                                ToolTip="{DynamicResource Str.Header.Minimize}">
                            <TextBlock Style="{StaticResource Glyph}"
                                       Text="&#xE921;"
                                       FontSize="{DynamicResource FontSize10}" />
                        </Button>

                        <Button x:Name="CloseButton"
                                Style="{StaticResource CloseButton}"
                                Width="32"
                                Height="32"
                                Margin="2,0,0,0"
                                Click="CloseButton_Click"
                                ToolTip="{DynamicResource Str.Header.CloseTray}">
                            <TextBlock Style="{StaticResource Glyph}"
                                       Text="&#xE8BB;"
                                       FontSize="{DynamicResource FontSize10}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="PageArea"
                  Margin="14,58,14,54"
                  Background="Transparent"
                  ClipToBounds="True"
                  PreviewMouseWheel="PageArea_PreviewMouseWheel">
                    <ListBox x:Name="PageList"
                             ItemsSource="{Binding VisibleItems}"
                             ItemTemplate="{StaticResource DesktopItemTemplate}"
                             ItemContainerStyle="{StaticResource DesktopListItem}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             SelectionMode="Extended"
                             SelectionChanged="PageList_SelectionChanged"
                             MouseDoubleClick="PageList_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="PageList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="PageList_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="PageList_PreviewMouseLeftButtonUp"
                             LostMouseCapture="PageList_LostMouseCapture"
                             PreviewMouseRightButtonDown="PageList_PreviewMouseRightButtonDown"
                             PreviewMouseRightButtonUp="PageList_PreviewMouseRightButtonUp"
                             KeyDown="PageList_KeyDown"
                             FocusVisualStyle="{x:Null}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding Columns}" Rows="{Binding Rows}" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <Image x:Name="PageSnapshotImage"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Stretch="Fill"
                           Visibility="Collapsed"
                           IsHitTestVisible="False" />

                    <Canvas x:Name="SelectionCanvas"
                            IsHitTestVisible="False"
                            ClipToBounds="True">
                        <Border x:Name="SelectionRect"
                                BorderBrush="{DynamicResource SelectionBorderBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource SelectionFillBrush}"
                                Visibility="Collapsed" />
                    </Canvas>

                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Glyph}"
                                   Text="&#xE8B7;"
                                   FontSize="{DynamicResource FontSize52}"
                                   Foreground="{DynamicResource EmptyGlyphBrush}" />
                        <TextBlock x:Name="EmptyTitle"
                                   Text="{DynamicResource Str.Empty.ClearTitle}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="{DynamicResource FontSize17}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />
                        <TextBlock x:Name="EmptySubtitle"
                                   Text="{DynamicResource Str.Empty.ClearText}"
                                   FontSize="{DynamicResource FontSize12}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <Border x:Name="ToastHost"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,16"
                            Padding="14,9"
                            Background="{DynamicResource ToastSurfaceBrush}"
                            BorderBrush="{DynamicResource ToastBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}"
                                       Text="&#xE946;"
                                       FontSize="{DynamicResource FontSize13}"
                                       Foreground="{DynamicResource AccentLightBrush}"
                                       Margin="0,0,8,0" />
                            <TextBlock x:Name="ToastText"
                                       Text=""
                                       FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

            <Border x:Name="PagerBar"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{DynamicResource PagerSurfaceBrush}"
                    BorderBrush="{DynamicResource PagerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="8,4">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button x:Name="PrevButton"
                            Style="{StaticResource IconButton}"
                            Width="28"
                            Height="28"
                            IsEnabled="False"
                            Click="PrevPage_Click"
                            ToolTip="{DynamicResource Str.Pager.Previous}">
                        <TextBlock Style="{StaticResource Glyph}"
                                   Text="&#xE76B;"
                                   FontSize="{DynamicResource FontSize11}" />
                    </Button>
                    <TextBlock Text="{Binding CurrentPageLabel}"
                               Width="90"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               FontSize="{DynamicResource FontSize105}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="9,0"
                               VerticalAlignment="Center" />
                    <Grid x:Name="DotsHost" VerticalAlignment="Center">
                        <Canvas x:Name="IndicatorCanvas"
                                IsHitTestVisible="False"
                                Visibility="{Binding ShowPageDots, Converter={StaticResource BoolToVisibility}}">
                            <Border x:Name="PageIndicator"
                                    Width="40"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="IndicatorTransform" />
                                </Border.RenderTransform>
                            </Border>
                        </Canvas>

                        <ItemsControl x:Name="PageItems"
                                      ItemsSource="{Binding PageDots}"
                                      Visibility="{Binding ShowPageDots, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource PageDotButton}"
                                            Content="{Binding Label}"
                                            ToolTip="{Binding Tooltip}"
                                            Tag="{Binding Index}"
                                            Click="PageDot_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- A second, clipped copy of the tab row: the clip window travels
                             with the accent pill, so only the digits under the pill are drawn
                             in the contrast colour (the label changes colour only where the
                             pill covers it). -->
                        <ItemsControl x:Name="ActivePageItems"
                                      Width="{Binding ActualWidth, ElementName=DotsHost}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding PageDots}"
                                      IsHitTestVisible="False"
                                      Focusable="False"
                                      Visibility="{Binding ShowPageDots, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.Clip>
                                <RectangleGeometry Rect="0,0,40,28">
                                    <RectangleGeometry.Transform>
                                        <TranslateTransform x:Name="ActiveClipGeometryTransform" />
                                    </RectangleGeometry.Transform>
                                </RectangleGeometry>
                            </ItemsControl.Clip>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="40" Height="28" Margin="1,0" IsHitTestVisible="False">
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="{DynamicResource FontSize11}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource OnAccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <Button x:Name="NextButton"
                            Style="{StaticResource IconButton}"
                            Width="28"
                            Height="28"
                            Margin="4,0,0,0"
                            IsEnabled="False"
                            Click="NextPage_Click"
                            ToolTip="{DynamicResource Str.Pager.Next}">
                        <TextBlock Style="{StaticResource Glyph}"
                                   Text="&#xE76C;"
                                   FontSize="{DynamicResource FontSize11}" />
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="SummaryText"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <TextBlock Text="{Binding ItemSummary}"
                           FontSize="{DynamicResource FontSize11}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <Border x:Name="HintText"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <TextBlock Text="{DynamicResource Str.Pager.Hint}"
                           FontSize="{DynamicResource FontSize105}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <Border x:Name="GroupBadge"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{DynamicResource BadgePanelBrush}"
                    BorderBrush="{DynamicResource StrokeStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,4"
                    Visibility="{Binding ShowGroupBadge, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding CurrentGroupText}"
                           FontSize="{DynamicResource FontSize11}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!-- Layout editor: dashed outlines and a resize grip per chrome element.
                 The canvas itself has no background, so only the grips are hit-testable. -->
            <Canvas x:Name="LayoutEditorCanvas"
                    Panel.ZIndex="40"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

            <!-- Floating layout toolbar: slides in from the right edge while editing. -->
            <Border x:Name="LayoutToolbar"
                    Panel.ZIndex="50"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0"
                    Padding="14,12"
                    CornerRadius="0"
                    Background="{DynamicResource SettingsPanelBrush}"
                    BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="LayoutToolbarTransform" X="240" />
                </Border.RenderTransform>

                <StackPanel>
                    <TextBlock Text="{DynamicResource Str.LayoutToolbar.Title}"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="{DynamicResource FontSize14}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Str.LayoutToolbar.Desc}"
                               FontSize="{DynamicResource FontSize105}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="190"
                               Margin="0,3,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{DynamicResource Str.Appearance.Reset}"
                                Style="{StaticResource GhostButton}"
                                Height="30"
                                Padding="14,0"
                                FontSize="{DynamicResource FontSize115}"
                                Click="LayoutToolbarReset_Click" />
                        <Button Content="{DynamicResource Str.LayoutToolbar.Done}"
                                Style="{StaticResource AccentButton}"
                                Height="30"
                                Padding="18,0"
                                FontSize="{DynamicResource FontSize115}"
                                Margin="8,0,0,0"
                                Click="LayoutToolbarDone_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay"
              Visibility="Collapsed"
              Panel.ZIndex="20">
            <Border x:Name="SettingsBackdrop"
                    Background="{DynamicResource ScrimBrush}"
                    MouseDown="SettingsBackdrop_MouseDown" />

            <Border x:Name="SettingsPanel"
                    Width="404"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource SettingsPanelBrush}"
                    BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SettingsTranslate" X="404" />
                </Border.RenderTransform>

                <Grid Margin="26,22,20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="Assets/app.png"
                                   Width="30"
                                   Height="30"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str.Settings.Title}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="{DynamicResource FontSize18}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Str.App.Title}"
                                           FontSize="{DynamicResource FontSize105}"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <Button x:Name="LanguageButton"
                                    Style="{StaticResource PanelIconButton}"
                                    Width="28"
                                    Height="28"
                                    Margin="0,1,4,0"
                                    AutomationProperties.Name="{DynamicResource Str.Settings.Language}"
                                    Click="LanguageButton_Click"
                                    ToolTip="{DynamicResource Str.Settings.Language}">
                                <TextBlock Style="{StaticResource Glyph}"
                                           Text="&#xE774;"
                                           FontSize="{DynamicResource FontSize14}" />
                            </Button>
                            <Button Style="{StaticResource PanelIconButton}"
                                    Width="28"
                                    Height="28"
                                    Click="SettingsCloseButton_Click"
                                    ToolTip="{DynamicResource Str.Settings.Close}">
                                <TextBlock Style="{StaticResource Glyph}"
                                           Text="&#xE8BB;"
                                           FontSize="{DynamicResource FontSize11}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,18,4,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,10">

                            <ContentControl Content="{DynamicResource Str.Section.Layout}" Style="{StaticResource SectionHeader}" />
                            <Grid Margin="0,0,10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.Layout.Title}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="{DynamicResource Str.Layout.Description}"
                                               Style="{StaticResource SettingDescription}" />
                                </StackPanel>
                                <Button x:Name="LayoutEditButton"
                                        Grid.Column="1"
                                        Style="{StaticResource GhostButton}"
                                        Content="{DynamicResource Str.Layout.Adjust}"
                                        Height="30"
                                        Padding="12,0"
                                        FontSize="{DynamicResource FontSize115}"
                                        VerticalAlignment="Center"
                                        Click="LayoutEditButton_Click" />
                            </Grid>
                            <Button Content="{DynamicResource Str.Layout.Reset}"
                                    Style="{StaticResource ToolbarButton}"
                                    HorizontalAlignment="Left"
                                    Padding="12,0"
                                    Height="30"
                                    FontSize="{DynamicResource FontSize115}"
                                    Margin="0,6,0,4"
                                    Click="ResetLayoutButton_Click" />

                            <ContentControl Content="{DynamicResource Str.Section.Appearance}" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{DynamicResource Str.Appearance.IconSize}" Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="{DynamicResource Str.Appearance.IconSizeDesc}"
                                       Style="{StaticResource SettingDescription}" />
                            <Border Background="{DynamicResource SegmentSurfaceBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    Padding="2"
                                    Margin="0,10,10,0"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CompactRadio"
                                                 GroupName="IconSize"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Content="{DynamicResource Str.Density.Compact}"
                                                 Tag="Compact"
                                                 Checked="DensityRadio_Checked" />
                                    <RadioButton x:Name="CozyRadio"
                                                 GroupName="IconSize"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Content="{DynamicResource Str.Density.Cozy}"
                                                 Tag="Cozy"
                                                 Checked="DensityRadio_Checked" />
                                    <RadioButton x:Name="LargeRadio"
                                                 GroupName="IconSize"
                                                 Style="{StaticResource SegmentRadio}"
                                                 Content="{DynamicResource Str.Density.Large}"
                                                 Tag="Large"
                                                 Checked="DensityRadio_Checked" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,14,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str.Appearance.CustomIcon}" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="IconSizeValueText" FontFamily="{StaticResource MonoFont}"
                                           Grid.Column="1"
                                           Text="72 px"
                                           FontSize="{DynamicResource FontSize11}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource Str.Appearance.Auto}"
                                        x:Name="AutoIconSizeButton"
                                        AutomationProperties.Name="{DynamicResource Str.Appearance.AutoIconTip}"
                                        Style="{StaticResource AutoButton}"
                                        Margin="8,0,0,0"
                                        ToolTip="{DynamicResource Str.Appearance.AutoIconTip}"
                                        Click="ResetIconSizeButton_Click" />
                            </Grid>
                            <Slider x:Name="IconSizeSlider"
                                    Minimum="24"
                                    Maximum="160"
                                    TickFrequency="2"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,8,10,0"
                                    ValueChanged="IconSizeSlider_ValueChanged" />

                            <Grid Margin="0,16,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str.Appearance.TextSize}" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="FontScaleValueText" FontFamily="{StaticResource MonoFont}"
                                           Grid.Column="1"
                                           Text="100%"
                                           FontSize="{DynamicResource FontSize11}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource Str.Appearance.Auto}"
                                        x:Name="AutoFontScaleButton"
                                        AutomationProperties.Name="{DynamicResource Str.Appearance.AutoTextTip}"
                                        Style="{StaticResource AutoButton}"
                                        Margin="8,0,0,0"
                                        ToolTip="{DynamicResource Str.Appearance.AutoTextTip}"
                                        Click="ResetFontScaleButton_Click" />
                            </Grid>
                            <TextBlock Text="{DynamicResource Str.Appearance.TextSizeDesc}"
                                       Style="{StaticResource SettingDescription}" />
                            <Slider x:Name="FontScaleSlider"
                                    Minimum="80"
                                    Maximum="140"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,8,10,0"
                                    ValueChanged="FontScaleSlider_ValueChanged" />

                            <Grid Margin="0,16,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.Appearance.Colors}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="{DynamicResource Str.Appearance.ColorsDesc}"
                                               Style="{StaticResource SettingDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{DynamicResource Str.Appearance.Reset}"
                                        Style="{StaticResource GhostButton}"
                                        Padding="10,0"
                                        Height="28"
                                        FontSize="{DynamicResource FontSize11}"
                                        VerticalAlignment="Center"
                                        Click="ResetColorsButton_Click" />
                            </Grid>

                            <Border Margin="0,10,10,0"
                                    Padding="6"
                                    CornerRadius="0"
                                    Background="{DynamicResource SegmentSurfaceBrush}"
                                    BorderBrush="{DynamicResource StrokeBrush}"
                                    BorderThickness="1">
                                <StackPanel x:Name="ColorRowsPanel" />
                            </Border>

                            <Grid Margin="0,16,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str.Appearance.WallpaperDim}" Style="{StaticResource SettingTitle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="WallpaperDimValueText" FontFamily="{StaticResource MonoFont}"
                                           Grid.Column="1"
                                           Text="0%"
                                           FontSize="{DynamicResource FontSize11}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource Str.Appearance.Auto}"
                                        x:Name="AutoWallpaperDimButton"
                                        AutomationProperties.Name="{DynamicResource Str.Appearance.AutoDimTip}"
                                        Style="{StaticResource AutoButton}"
                                        Margin="8,0,0,0"
                                        ToolTip="{DynamicResource Str.Appearance.AutoDimTip}"
                                        Click="ResetWallpaperDimButton_Click" />
                            </Grid>
                            <TextBlock Text="{DynamicResource Str.Appearance.WallpaperDimDesc}"
                                       Style="{StaticResource SettingDescription}" />
                            <Slider x:Name="WallpaperDimSlider"
                                    Minimum="0"
                                    Maximum="60"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,8,10,0"
                                    ValueChanged="WallpaperDimSlider_ValueChanged" />

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18,10,16" />

                            <ContentControl Content="{DynamicResource Str.Section.Grid}" Style="{StaticResource SectionHeader}" />

                            <Grid Margin="0,0,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.Grid.Fit}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="{DynamicResource Str.Grid.FitDesc}"
                                               Style="{StaticResource SettingDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="AutoGridToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="AutoGridToggle_Changed"
                                          Unchecked="AutoGridToggle_Changed" />
                            </Grid>

                            <Grid Margin="0,6,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str.Grid.Columns}" FontSize="{DynamicResource FontSize115}" VerticalAlignment="Center" />
                                <Slider x:Name="ColumnsSlider"
                                        Grid.Column="1"
                                        Minimum="2"
                                        Maximum="16"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,0,10,0"
                                        ValueChanged="GridSlider_ValueChanged" />
                                <TextBlock x:Name="ColumnsValueText" FontFamily="{StaticResource MonoFont}"
                                           Grid.Column="2"
                                           Text="8"
                                           FontSize="{DynamicResource FontSize11}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Grid.Column="3"
                                        Content="{DynamicResource Str.Appearance.Auto}"
                                        x:Name="AutoColumnsButton"
                                        AutomationProperties.Name="{DynamicResource Str.Grid.AutoTip}"
                                        Style="{StaticResource AutoButton}"
                                        Height="24"
                                        Padding="6,0"
                                        Margin="6,0,0,0"
                                        ToolTip="{DynamicResource Str.Grid.AutoTip}"
                                        Click="AutoGridButton_Click" />
                            </Grid>

                            <Grid Margin="0,8,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str.Grid.Rows}" FontSize="{DynamicResource FontSize115}" VerticalAlignment="Center" />
                                <Slider x:Name="RowsSlider"
                                        Grid.Column="1"
                                        Minimum="1"
                                        Maximum="16"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,0,10,0"
                                        ValueChanged="GridSlider_ValueChanged" />
                                <TextBlock x:Name="RowsValueText" FontFamily="{StaticResource MonoFont}"
                                           Grid.Column="2"
                                           Text="4"
                                           FontSize="{DynamicResource FontSize11}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Grid.Column="3"
                                        Content="{DynamicResource Str.Appearance.Auto}"
                                        x:Name="AutoRowsButton"
                                        AutomationProperties.Name="{DynamicResource Str.Grid.AutoTip}"
                                        Style="{StaticResource AutoButton}"
                                        Height="24"
                                        Padding="6,0"
                                        Margin="6,0,0,0"
                                        ToolTip="{DynamicResource Str.Grid.AutoTip}"
                                        Click="AutoGridButton_Click" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,20,10,18" />

                            <ContentControl Content="{DynamicResource Str.Section.Sorting}" Style="{StaticResource SectionHeader}" />

                            <Grid Margin="0,0,10,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.Sorting.FoldersFirst}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="{DynamicResource Str.Sorting.FoldersFirstDesc}"
                                               Style="{StaticResource SettingDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="FoldersFirstToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="FoldersFirstToggle_Changed"
                                          Unchecked="FoldersFirstToggle_Changed" />
                            </Grid>

                            <Grid Margin="0,0,10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.Sorting.ShowHidden}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="{DynamicResource Str.Sorting.ShowHiddenDesc}"
                                               Style="{StaticResource SettingDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="ShowHiddenToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="ShowHiddenToggle_Changed"
                                          Unchecked="ShowHiddenToggle_Changed" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,20,10,18" />

                            <ContentControl Content="{DynamicResource Str.Section.Behavior}" Style="{StaticResource SectionHeader}" />

                            <Grid Margin="0,0,10,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.Behavior.AlwaysShow}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="{DynamicResource Str.Behavior.AlwaysShowDesc}"
                                               Style="{StaticResource SettingDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="AlwaysShowChromeToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="AlwaysShowChromeToggle_Changed"
                                          Unchecked="AlwaysShowChromeToggle_Changed" />
                            </Grid>

                            <Grid Margin="0,0,10,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.Behavior.CloseToTray}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="{DynamicResource Str.Behavior.CloseToTrayDesc}"
                                               Style="{StaticResource SettingDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="CloseToTrayToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="CloseToTrayToggle_Changed"
                                          Unchecked="CloseToTrayToggle_Changed" />
                            </Grid>

                            <Grid Margin="0,0,10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.Behavior.StartWithWindows}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="{DynamicResource Str.Behavior.StartWithWindowsDesc}"
                                               Style="{StaticResource SettingDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="StartWithWindowsToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="StartWithWindowsToggle_Changed"
                                          Unchecked="StartWithWindowsToggle_Changed" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,20,10,18" />

                            <ContentControl Content="{DynamicResource Str.Section.Windows}" Style="{StaticResource SectionHeader}" />

                            <Grid Margin="0,0,10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.Windows.HideNow}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="{DynamicResource Str.Windows.HideNowDesc}"
                                               Style="{StaticResource SettingDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="HideIconsSettingsToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="HideIconsSettingsToggle_Changed"
                                          Unchecked="HideIconsSettingsToggle_Changed" />
                            </Grid>

                            <Grid Margin="0,8,10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str.Windows.HideOnLaunch}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="{DynamicResource Str.Windows.HideOnLaunchDesc}"
                                               Style="{StaticResource SettingDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="HideIconsOnLaunchToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center"
                                          Checked="HideIconsOnLaunchToggle_Changed"
                                          Unchecked="HideIconsOnLaunchToggle_Changed" />
                            </Grid>

                            <TextBlock Text="{DynamicResource Str.Windows.RestoreNote}"
                                       Style="{StaticResource SettingDescription}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,10,12" />

                            <WrapPanel Margin="0,0,10,0">
                                <Button Style="{StaticResource GhostButton}"
                                        Content="{DynamicResource Str.Windows.OpenFolder}"
                                        Margin="0,0,8,8"
                                        Click="OpenDesktopFolderButton_Click" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="{DynamicResource Str.Windows.RefreshIcons}"
                                        Margin="0,0,8,8"
                                        Click="RefreshIconsButton_Click" />
                            </WrapPanel>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,20,10,18" />

                            <ContentControl Content="{DynamicResource Str.Section.About}" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{DynamicResource Str.About.Version}"
                                       Style="{StaticResource SettingTitle}" />
                            <TextBlock Text="{DynamicResource Str.About.Text}"
                                       Style="{StaticResource SettingDescription}" />
                            <WrapPanel Margin="0,12,10,0">
                                <Button Style="{StaticResource GhostButton}"
                                        Content="{DynamicResource Str.About.OpenData}"
                                        Margin="0,0,8,8"
                                        Click="OpenDataFolderButton_Click" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="{DynamicResource Str.About.Exit}"
                                        Foreground="{DynamicResource DangerBrush}"
                                        Margin="0,0,8,8"
                                        Click="ExitApplicationButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,12,10,0">
                        <Border Height="1"
                                Background="{DynamicResource DividerBrush}"
                                Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource Str.Settings.AutoSaved}"
                                   FontSize="{DynamicResource FontSize105}"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ColorPickerOverlay"
                  Background="{DynamicResource PickerScrimBrush}"
                  Visibility="Collapsed"
                  Panel.ZIndex="30"
                  MouseDown="ColorPickerBackdrop_MouseDown">
                <Border x:Name="ColorPickerCard"
                        Width="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="22,20,22,18"
                        CornerRadius="0"
                        Background="{DynamicResource SettingsPanelBrush}"
                        BorderBrush="{DynamicResource SettingsPanelBorderBrush}"
                        BorderThickness="1">

                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str.ColorPicker.Title}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="{DynamicResource FontSize17}"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="PickerTokenLabel"
                                           Text="{DynamicResource Str.ColorToken.Accent}"
                                           FontSize="{DynamicResource FontSize11}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource PanelIconButton}"
                                    Width="30"
                                    Height="30"
                                    Click="ColorPickerCancel_Click"
                                    ToolTip="{DynamicResource Str.ColorPicker.Close}">
                                <TextBlock Style="{StaticResource Glyph}"
                                           Text="&#xE8BB;"
                                           FontSize="{DynamicResource FontSize10}" />
                            </Button>
                        </Grid>

                        <Border Height="1"
                                Margin="0,14,0,0"
                                Background="{DynamicResource StrokeBrush}" />

                        <Border x:Name="PickerPreviewBorder"
                                Height="56"
                                Margin="0,14,0,0"
                                CornerRadius="0"
                                BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush x:Name="PickerPreviewBrush" Color="#E8E8E8" />
                            </Border.Background>
                            <TextBlock x:Name="PickerPreviewText" FontFamily="{StaticResource MonoFont}"
                                       Text="#E8E8E8"
                                       FontSize="{DynamicResource FontSize13}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <UniformGrid x:Name="PickerPaletteGrid"
                                     Columns="8"
                                     Margin="0,14,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="R" FontFamily="{StaticResource MonoFont}"
                                       FontSize="{DynamicResource FontSize115}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid Grid.Column="1" Margin="0,0,12,0">
                                <Border Height="4"
                                        Margin="0"
                                        CornerRadius="0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource RedChannelBrush}" />
                                <Slider x:Name="RedSlider"
                                        AutomationProperties.Name="{DynamicResource Str.A11y.Red}"
                                        Style="{StaticResource ChannelSlider}"
                                        Minimum="0"
                                        Maximum="255"
                                        ValueChanged="ColorChannelSlider_ValueChanged" />
                            </Grid>
                            <TextBox x:Name="RedBox"
                                     AutomationProperties.Name="{DynamicResource Str.A11y.RedValue}"
                                     Grid.Column="2"
                                     Style="{StaticResource PickerValueBox}"
                                     MaxLength="3"
                                     KeyDown="ColorChannelBox_KeyDown"
                                     LostFocus="ColorChannelBox_LostFocus" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="G" FontFamily="{StaticResource MonoFont}"
                                       FontSize="{DynamicResource FontSize115}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid Grid.Column="1" Margin="0,0,12,0">
                                <Border Height="4"
                                        Margin="0"
                                        CornerRadius="0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource GreenChannelBrush}" />
                                <Slider x:Name="GreenSlider"
                                        AutomationProperties.Name="{DynamicResource Str.A11y.Green}"
                                        Style="{StaticResource ChannelSlider}"
                                        Minimum="0"
                                        Maximum="255"
                                        ValueChanged="ColorChannelSlider_ValueChanged" />
                            </Grid>
                            <TextBox x:Name="GreenBox"
                                     AutomationProperties.Name="{DynamicResource Str.A11y.GreenValue}"
                                     Grid.Column="2"
                                     Style="{StaticResource PickerValueBox}"
                                     MaxLength="3"
                                     KeyDown="ColorChannelBox_KeyDown"
                                     LostFocus="ColorChannelBox_LostFocus" />
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="B" FontFamily="{StaticResource MonoFont}"
                                       FontSize="{DynamicResource FontSize115}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Grid Grid.Column="1" Margin="0,0,12,0">
                                <Border Height="4"
                                        Margin="0"
                                        CornerRadius="0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource BlueChannelBrush}" />
                                <Slider x:Name="BlueSlider"
                                        AutomationProperties.Name="{DynamicResource Str.A11y.Blue}"
                                        Style="{StaticResource ChannelSlider}"
                                        Minimum="0"
                                        Maximum="255"
                                        ValueChanged="ColorChannelSlider_ValueChanged" />
                            </Grid>
                            <TextBox x:Name="BlueBox"
                                     AutomationProperties.Name="{DynamicResource Str.A11y.BlueValue}"
                                     Grid.Column="2"
                                     Style="{StaticResource PickerValueBox}"
                                     MaxLength="3"
                                     KeyDown="ColorChannelBox_KeyDown"
                                     LostFocus="ColorChannelBox_LostFocus" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Str.ColorPicker.Hex}"
                                       FontSize="{DynamicResource FontSize115}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,12,0" />
                            <TextBox x:Name="PickerHexBox"
                                     AutomationProperties.Name="{DynamicResource Str.A11y.HexValue}"
                                     Grid.Column="1"
                                     Height="28"
                                     Style="{StaticResource PickerValueBox}"
                                     MaxLength="7"
                                     KeyDown="PickerHexBox_KeyDown"
                                     TextChanged="PickerHexBox_TextChanged"
                                     LostFocus="PickerHexBox_LostFocus" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Button Content="{DynamicResource Str.Appearance.Reset}"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left"
                                    Height="30"
                                    Padding="12,0"
                                    FontSize="{DynamicResource FontSize115}"
                                    Click="ColorPickerReset_Click" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{DynamicResource Str.ColorPicker.Cancel}"
                                        Style="{StaticResource GhostButton}"
                                        Height="30"
                                        Padding="14,0"
                                        FontSize="{DynamicResource FontSize115}"
                                        Click="ColorPickerCancel_Click" />
                                <Button Content="{DynamicResource Str.ColorPicker.Apply}"
                                        AutomationProperties.Name="{DynamicResource Str.ColorPicker.Apply}"
                                        Style="{StaticResource AccentButton}"
                                        Height="30"
                                        Padding="16,0"
                                        FontSize="{DynamicResource FontSize115}"
                                        Margin="8,0,0,0"
                                        Click="ColorPickerApply_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
