<Window x:Class="DesktopDrawer.Bootstrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Drawer"
        Width="500"
        Height="290"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{StaticResource Surface}"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Desktop Drawer"
                       FontSize="24"
                       FontWeight="SemiBold" />

            <TextBlock Grid.Row="1"
                       Text="在线安装器"
                       FontSize="12"
                       Foreground="{StaticResource Muted}"
                       Margin="0,2,0,0" />

            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Text="正在获取最新版本…"
                       FontSize="13"
                       Foreground="{StaticResource Muted}"
                       Margin="0,22,0,10"
                       TextWrapping="Wrap" />

            <ProgressBar x:Name="Progress"
                         Grid.Row="3"
                         Height="6"
                         Minimum="0"
                         Maximum="1"
                         Foreground="{StaticResource Accent}"
                         Background="{StaticResource Panel}"
                         BorderThickness="0"
                         VerticalAlignment="Top" />

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button x:Name="CloseButton"
                        Content="取消"
                        Background="{StaticResource Panel}"
                        Click="CloseButton_Click" />
                <Button x:Name="InstallButton"
                        Content="安装最新版"
                        Background="{StaticResource Accent}"
                        Margin="10,0,0,0"
                        IsEnabled="False"
                        Click="InstallButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
