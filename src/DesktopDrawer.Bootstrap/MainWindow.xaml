<Window x:Class="DesktopDrawer.Bootstrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Drawer"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="#D2080808"
            BorderBrush="#3DFFFFFF"
            BorderThickness="1"
            Padding="22">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="pack://application:,,,/app.png"
                       Width="40"
                       Height="40"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Desktop Drawer" FontSize="16" FontWeight="SemiBold" Foreground="#F7F7FA" />
                    <TextBlock Text="A paged desktop" FontSize="11" Foreground="#8F8F9A" Margin="0,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="Team Daydream"
                               FontSize="11"
                               Foreground="#8F8F9A"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Image Source="pack://application:,,,/team-daydream.png"
                           Width="22"
                           Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </StackPanel>
            </Grid>

            <Border Height="1" Background="#1CFFFFFF" Margin="0,18,0,18" />

            <TextBlock x:Name="StatusText"
                       Text="正在获取最新版本…"
                       FontSize="13"
                       Foreground="#C9C9D1"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="MetaText"
                       Text=" "
                       FontSize="11"
                       Foreground="#8F8F9A"
                       Margin="0,4,0,0" />

            <ProgressBar x:Name="Progress"
                         Height="4"
                         Minimum="0"
                         Maximum="1"
                         Margin="0,14,0,0"
                         Foreground="#FFFFFF"
                         Background="#17FFFFFF"
                         BorderThickness="0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CloseButton"
                        Content="取消"
                        Height="32"
                        Padding="18,0"
                        Foreground="#F7F7FA"
                        Background="Transparent"
                        BorderBrush="#3DFFFFFF"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="CloseButton_Click" />
                <Button x:Name="InstallButton"
                        Content="安装"
                        Height="32"
                        Padding="18,0"
                        Margin="8,0,0,0"
                        Foreground="#101014"
                        Background="#FFFFFF"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        IsEnabled="False"
                        Cursor="Hand"
                        Click="InstallButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
